{
  "name": "vscode-debug-preflight",
  "version": "0.1.0",
  "description": "Check VS Code launch, compound, and task references before F5 or CI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thisbejim/vscode-debug-preflight.git"
  },
  "bugs": { "url": "https://github.com/thisbejim/vscode-debug-preflight/issues" },
